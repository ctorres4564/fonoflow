{
  "name": "sistema-fonoaudiologia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:homologation": "vite --mode homologation",
    "emulators:homologation": "firebase emulators:start --only firestore,auth,storage --project demo-fonoflow",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run --exclude tests/firestore.rules.test.js --exclude tests/storage.rules.test.js --exclude api/_lib/evolutionFinalizeEmulator.test.js --exclude api/_lib/evolutionFinalizeAdminScript.test.js --exclude api/_lib/homeCareEmulator.test.js --exclude api/_lib/patientAccountingEmulator.test.js",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-fonoflow \"npm run test:emulator:unit\"",
    "test:emulator:unit": "vitest run --no-file-parallelism api/_lib/evolutionFinalizeEmulator.test.js api/_lib/evolutionFinalizeAdminScript.test.js api/_lib/homeCareEmulator.test.js api/_lib/patientAccountingEmulator.test.js",
    "test:emulator:repeat": "firebase emulators:exec --only firestore,auth --project demo-fonoflow \"node scripts/repeat-emulator-tests.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-fonoflow \"npm run test:rules:unit\"",
    "test:rules:unit": "vitest run tests/firestore.rules.test.js",
    "test:storage": "firebase emulators:exec --only storage --project demo-fonoflow \"npm run test:storage:unit\"",
    "test:storage:unit": "vitest run tests/storage.rules.test.js",
    "test:watch": "vitest",
    "migrate:patients:dry": "node scripts/migrate-patients-v1-to-v2.js --dry-run",
    "migrate:patients": "node scripts/migrate-patients-v1-to-v2.js --execute --confirm-write",
    "migrate:evolutions:dry": "node scripts/migrate-evolutions-v1-to-v2.js --dry-run",
    "migrate:evolutions": "node scripts/migrate-evolutions-v1-to-v2.js --execute --confirm-write",
    "migrate:appointments:dry": "node scripts/migrate-appointments-v1-to-v2.js --dry-run",
    "migrate:appointments": "node scripts/migrate-appointments-v1-to-v2.js --execute --confirm-write",
    "seed:schema:fixtures": "node scripts/seed-schema-migration-fixtures.js",
    "test:migrations:dry": "firebase emulators:exec --only firestore --project demo-fonoflow \"node scripts/verify-schema-migrations.js\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.5.0",
    "pdfkit": "^0.19.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "firebase-tools": "^15.23.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.13",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
