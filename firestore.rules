rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPatientOwner(patientId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/patients/$(patientId)).data.userId == request.auth.uid;
    }

    function validPatientDocument(data) {
      return !('schemaVersion' in data) || (
        data.schemaVersion == 2 && data.userId is string &&
        data.personalData is map && data.personalData.fullName is string && data.personalData.fullName.size() > 0 &&
        data.homeCare is map && data.homeCare.enabled is bool &&
        data.status in ['active', 'inactive', 'discharged', 'archived']
      );
    }

    function validScheduleDocument(data) {
      return !('schemaVersion' in data) || (
        data.schemaVersion == 2 && data.userId is string && data.patientId is string &&
        data.serviceType in ['clinic', 'home_care', 'online'] &&
        data.status in ['scheduled','confirmed','in_transit','arrived','completed','patient_absent','cancelled_by_patient','cancelled_by_professional','rescheduled'] &&
        data.sessionAccounting is map && data.sessionAccounting.deductSession is bool &&
        data.sessionAccounting.deductSession == (data.status == 'completed')
      );
    }

    function canonicalScheduleStatus(status) {
      return status == 'Agendado' ? 'scheduled' : status == 'Confirmado' ? 'confirmed' :
        status == 'Em deslocamento' ? 'in_transit' : status == 'Chegou' ? 'arrived' :
        status == 'Realizado' ? 'completed' : status == 'Falta' ? 'patient_absent' :
        status == 'Cancelado pelo paciente' ? 'cancelled_by_patient' :
        status == 'Cancelado pela profissional' ? 'cancelled_by_professional' :
        status == 'Reagendado' ? 'rescheduled' : status;
    }

    function validScheduleTransition(before, after) {
      let current = canonicalScheduleStatus(before.status);
      let target = canonicalScheduleStatus(after.status);
      return current == target ||
        (current == 'scheduled' && target in ['confirmed','in_transit','arrived','completed','patient_absent','cancelled_by_patient','cancelled_by_professional','rescheduled']) ||
        (current == 'confirmed' && target in ['scheduled','in_transit','arrived','completed','patient_absent','cancelled_by_patient','cancelled_by_professional','rescheduled']) ||
        (current == 'in_transit' && target in ['arrived','completed','cancelled_by_patient','cancelled_by_professional','rescheduled']) ||
        (current == 'arrived' && target in ['completed','patient_absent','cancelled_by_patient','cancelled_by_professional','rescheduled']) ||
        (current in ['patient_absent','cancelled_by_patient','cancelled_by_professional'] && target == 'rescheduled');
    }

    function validHomeCareVisit(data, scheduleId) {
      return data.schemaVersion == 1 && data.appointmentId == scheduleId &&
        data.patientId is string && data.professionalId is string && data.userId is string &&
        data.status in ['planned','in_transit','arrived','in_service','completed','patient_absent','cancelled'] &&
        data['location'] is map && data['location']['addressSnapshot'] is map &&
        data['travel'] is map && data['service'] is map && data['occurrence'] is map;
    }

    function validHomeCareTransition(before, after) {
      return before.status == after.status ||
        (before.status == 'planned' && after.status in ['in_transit','patient_absent','cancelled']) ||
        (before.status == 'in_transit' && after.status in ['arrived','cancelled']) ||
        (before.status == 'arrived' && after.status in ['in_service','patient_absent']) ||
        (before.status == 'in_service' && after.status == 'completed');
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.plan == 'demo' &&
        (!('features' in request.resource.data) || request.resource.data.features == null || !('evolutionQualityReview' in request.resource.data.features) || request.resource.data.features.evolutionQualityReview == false) &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'plan', 'features', 'createdAt']);
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        (
          (
            !('features' in request.resource.data) && !('features' in resource.data)
          ) || (
            (
              !('features' in resource.data) || resource.data.features == null || !('evolutionQualityReview' in resource.data.features)
            ) ? (
              !('features' in request.resource.data) || request.resource.data.features == null || !('evolutionQualityReview' in request.resource.data.features) || request.resource.data.features.evolutionQualityReview == false
            ) : (
              ('features' in request.resource.data) && request.resource.data.features != null && ('evolutionQualityReview' in request.resource.data.features) && request.resource.data.features.evolutionQualityReview == resource.data.features.evolutionQualityReview
            )
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'features', 'updatedAt']);
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && validPatientDocument(request.resource.data);
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        validPatientDocument(request.resource.data);

      match /evolutions/{evolutionId} {
        // O registro original é imutável após a criação: exclusão nunca é
        // permitida, e a única alteração aceita no documento é a anulação
        // (voided/voidedAt/voidedBy/voidReason), sem tocar no conteúdo
        // clínico original. Correções de conteúdo só podem ser feitas por
        // meio de retificações (subcoleção amendments), que nunca reescrevem
        // o registro original.
        allow read: if isPatientOwner(patientId);
        allow create: if isPatientOwner(patientId);
        allow update: if isPatientOwner(patientId) &&
          resource.data.get('voided', false) != true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voided', 'voidedAt', 'voidedBy', 'voidReason']) &&
          request.resource.data.status == 'voided' &&
          request.resource.data.voided == true &&
          request.resource.data.get('voidedBy', '') == request.auth.uid &&
          request.resource.data.voidReason is string &&
          request.resource.data.voidReason.size() > 0;
        allow delete: if false;

        match /amendments/{amendmentId} {
          allow read, create: if isPatientOwner(patientId);
          allow update, delete: if false;
        }

        // Coleção de qualityReviews protegida contra escritas diretas do cliente
        match /qualityReviews/{reviewId} {
          allow read: if isPatientOwner(patientId);
          allow write: if false;
        }

        match /attachments/{attachmentId} {
          allow read: if isPatientOwner(patientId);
          allow create, update, delete: if false;
        }
      }

      match /anamnesis/{anamnesisId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/patients/$(patientId)).data.userId == request.auth.uid;
      }

      match /progressAnalyses/{analysisId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/patients/$(patientId)).data.userId == request.auth.uid;
      }

      match /evolutionDrafts/{draftId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/patients/$(patientId)).data.userId == request.auth.uid;
      }

      match /therapeuticPlan/{planId} {
        allow read, write: if request.auth != null &&
          get(/databases/$(database)/documents/patients/$(patientId)).data.userId == request.auth.uid;
      }

      match /documents/{documentId} {
        // O proprietario pode ler o registro documental. A interface usa a
        // API sanitizada; scans, versoes e todas as mutacoes ficam no backend.
        allow read: if isPatientOwner(patientId);
        allow create, update, delete: if false;

        match /securityScans/{scanId} {
          allow read: if false;
          allow create, update, delete: if false;
        }

        match /versions/{versionId} {
          allow read: if false;
          allow create, update, delete: if false;
        }
      }

      match /consents/{consentId} {
        allow read: if isPatientOwner(patientId);
        allow create, update, delete: if false;
      }
    }

    match /schedules/{scheduleId} {
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && validScheduleDocument(request.resource.data);
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        validScheduleDocument(request.resource.data) &&
        validScheduleTransition(resource.data, request.resource.data);

      match /statusHistory/{historyId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/schedules/$(scheduleId)).data.userId == request.auth.uid;
        allow create: if request.auth != null &&
          get(/databases/$(database)/documents/schedules/$(scheduleId)).data.userId == request.auth.uid &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.operationId == historyId;
        allow update, delete: if false;
      }

      match /homeCareVisit/{visitId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/schedules/$(scheduleId)).data.userId == request.auth.uid;
        allow create: if request.auth != null && visitId == 'current' &&
          get(/databases/$(database)/documents/schedules/$(scheduleId)).data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid && request.resource.data.professionalId == request.auth.uid &&
          request.resource.data.status == 'planned' && validHomeCareVisit(request.resource.data, scheduleId);
        allow update: if request.auth != null &&
          get(/databases/$(database)/documents/schedules/$(scheduleId)).data.userId == request.auth.uid &&
          resource.data.status != 'completed' && resource.data.status != 'patient_absent' && resource.data.status != 'cancelled' &&
          request.resource.data.userId == resource.data.userId && request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.appointmentId == resource.data.appointmentId && request.resource.data.professionalId == resource.data.professionalId &&
          request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy &&
          validHomeCareVisit(request.resource.data, scheduleId) && validHomeCareTransition(resource.data, request.resource.data);
        allow delete: if false;

        match /attachments/{attachmentId} {
          allow read: if request.auth != null &&
            get(/databases/$(database)/documents/schedules/$(scheduleId)).data.userId == request.auth.uid;
          allow create, update, delete: if false;
        }
      }

      match /attachments/{attachmentId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/schedules/$(scheduleId)).data.userId == request.auth.uid;
        allow create, update, delete: if false;
      }
    }

    // Coleções técnicas da Fase 2B (idempotência e rate limits) protegidas contra escritas diretas do cliente
    match /evolutionFinalizeOperations/{operationId} {
      allow read, write: if false;
    }

    match /evolutionFinalizeRateLimits/{identifier} {
      allow read, write: if false;
    }

    match /consentOperations/{requestId} {
      allow read, write: if false;
    }

    match /documentStorageOperations/{requestId} {
      allow read, write: if false;
    }

    match /clinicalAttachmentOperations/{requestId} {
      allow read, write: if false;
    }

    // Criados e consultados exclusivamente pelo backend autenticado. O cliente
    // nunca pode alterar ou apagar a trilha de auditoria.
    match /auditLogs/{eventId} {
      allow read, create, update, delete: if false;
    }

    // Dados de cobrança, cotas e demais coleções só podem ser acessados pelo backend.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
